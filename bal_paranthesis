s = input("Enter parentheses: ")

stack = []

for ch in s:
    if ch in "({[":
        stack.append(ch)
    elif ch in ")}]":
        if not stack:
            print("Not Balanced")
            break

        top = stack.pop()

        if (ch == ")" and top != "(") or \
           (ch == "}" and top != "{") or \
           (ch == "]" and top != "["):
            print("Not Balanced")
            break
else:
    if not stack:
        print("Balanced")
    else:
        print("Not Balanced")
